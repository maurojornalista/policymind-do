# Copie este arquivo para .env e preencha. NUNCA versione o arquivo .env.

# Configuração final da entrega: OpenAI / gpt-4o-mini
OPENAI_API_KEY=sk-coloque-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=120

# Limite de caracteres do documento enviados ao LLM
MAX_CHARS_LLM=120000

# OCR (Tesseract) — usado apenas para páginas sem texto e para imagens
OCR_ENABLED=true
OCR_LANG=por
# Windows: informe o caminho se o Tesseract não estiver no PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Se a IA falhar, faz extração mínima por regras (exibida como "SEM IA")
ALLOW_RULE_FALLBACK=true

# Cache/armazenamento estruturado em SQLite
CACHE_ENABLED=true
